# Скопируй этот файл в .env и заполни. Файл .env в GitHub не попадает.

# Порт. На хостинге обычно задаётся панелью сам, тогда оставь пустым.
PORT=

# База MySQL. Если не заполнено — мир хранится в папке data/.
DB_HOST=localhost
DB_PORT=3306
DB_NAME=
DB_USER=
DB_PASSWORD=

# Ключ управления. Если задан, переворачивать мир, звать зиму и т.д. может только тот, кто знает ключ.
# Если пусто — управлять может любой посетитель сайта.
ADMIN_KEY=

# Скорость жизни: тиков в секунду
TPS=20
# Как часто сохранять мир, секунд
SAVE_EVERY_SEC=30
# Сколько тиков максимум досчитывать после сна сервера (300000 при TPS=20 — это ~4 часа)
MAX_CATCHUP_TICKS=300000
